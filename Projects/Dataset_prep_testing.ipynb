    "    \"traffic_df['hour']=traffic_df['date_time'].dt.hour\\n\",\n",
    "    \"traffic_df['dayOfWeek']=traffic_df['date_time'].dt.weekday\\n\",\n",
    "    \"traffic_df['month'] = traffic_df['date_time'].dt.month\\n\",\n",
    "    \"traffic_df['isWeekend'] = (traffic_df['date_time'].dt.weekday >= 5).astype(int)\\n\",\n",
    "    \"traffic_df['hour_sin'] = np.sin(2 * np.pi * traffic_df['hour'] / 24.0)\\n\",\n",
    "    \"traffic_df['hour_cos'] = np.cos(2 * np.pi * traffic_df['hour'] / 24.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"features_test1 = ['dayOfWeek', 'month', 'hour_sin', 'hour_cos', 'isHoliday']\\n\",\n",
    "    \"X1 = traffic_df[features_test1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"num_features_test2 = ['temp', 'rain_1h', 'snow_1h', 'clouds_all', 'dayOfWeek', 'month', 'hour_sin', 'hour_cos', 'isHoliday']\\n\",\n",
    "    \"cat_features_test2 = ['weather_main']\\n\",\n",
    "    \"X2 = traffic_df[num_features_test2+cat_features_test2]\\n\",\n",
