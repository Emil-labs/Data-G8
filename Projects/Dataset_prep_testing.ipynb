    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.ensemble import RandomForestRegressor\\n\",\n",
    "    \"from sklearn.model_selection import TimeSeriesSplit\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Time series split\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"tss = TimeSeriesSplit(n_splits=10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Take ONLY the last fold\\n\",\n",
    "    \"for train_index, test_index in tss.split(X2):\\n\",\n",
    "    \"    pass\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_tr, X_te = X2.iloc[train_index], X2.iloc[test_index]\\n\",\n",
    "    \"y_tr, y_te = y[train_index], y[test_index]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Preprocessing\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Random Forest does NOT require scaling,\\n\",\n",
    "    \"# but we still need one-hot encoding.\\n\",\n",
    "    \"\\n\",\n",
    "    \"preprocessor_rf = ColumnTransformer(\\n\",\n",
    "    \"    transformers=[\\n\",\n",
    "    \"        ('cat', OneHotEncoder(handle_unknown='ignore'), cat_features_test2)\\n\",\n",
    "    \"    ],\\n\",\n",
    "    \"    remainder='passthrough'\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_tr = preprocessor_rf.fit_transform(X_tr)\\n\",\n",
    "    \"X_te = preprocessor_rf.transform(X_te)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Train Random Forest\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"RF_reg = RandomForestRegressor(\\n\",\n",
    "    \"    n_estimators=100,\\n\",\n",
    "    \"    max_depth=15,\\n\",\n",
    "    \"    random_state=42,\\n\",\n",
    "    \"    n_jobs=-1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"RF_reg.fit(X_tr, y_tr)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Predictions\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_pred = RF_reg.predict(X_te)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"R2:\\\", r2_score(y_te, y_pred))\\n\",\n",
    "    \"print(\\\"RMSE:\\\", np.sqrt(mean_squared_error(y_te, y_pred)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Select ONE WEEK from the test fold\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"dates_test = traffic_df.iloc[test_index]['date_time'].reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"start_date = dates_test.iloc[0]\\n\",\n",
    "    \"end_date = start_date + pd.Timedelta(days=7)\\n\",\n",
    "    \"\\n\",\n",
    "    \"week_mask = (dates_test >= start_date) & (dates_test < end_date)\\n\",\n",
    "    \"\\n\",\n",
    "    \"dates_week = dates_test[week_mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_real_week = y_te[week_mask]\\n\",\n",
    "    \"y_pred_week = y_pred[week_mask]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"# Plot\\n\",\n",
    "    \"# ---------------------------------------------------------\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(14,6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.plot(dates_week, y_real_week, label='Real traffic')\\n\",\n",
    "    \"plt.plot(dates_week, y_pred_week, label='Random Forest prediction')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.xlabel('Date')\\n\",\n",
    "    \"plt.ylabel('Traffic volume')\\n\",\n",
    "    \"plt.title('Random Forest - One Week Prediction on Test Fold')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.grid(True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.xticks(rotation=45)\\n\",\n",
    "    \"\\n\",\n",
