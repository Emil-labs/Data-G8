    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.linear_model import LassoCV\\n\",\n",
    "    \"tss = TimeSeriesSplit(n_splits = 10, gap = 0)\\n\",\n",
    "    \"for train_index, test_index in tss.split(traffic_df):\\n\",\n",
    "    \"    # Split data sequentially\\n\",\n",
    "    \"    X_tr, X_te = X2.iloc[train_index], X2.iloc[test_index]\\n\",\n",
