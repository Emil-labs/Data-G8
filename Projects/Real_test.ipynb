    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.preprocessing import StandardScaler\\n\",\n",
    "    \"from sklearn.decomposition import PCA\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_pca = pd.concat([Xp, yp], axis=1)\\n\",\n",
    "    \"X_pca = np.array(df_pca)\\n\",\n",
    "    \"traffic_features = df_pca.columns.values\\n\",\n",
    "    \"print(traffic_features)\\n\",\n",
    "    \"n_features = traffic_features.size\\n\",\n",
    "    \"\\n\",\n",
    "    \"scaler = StandardScaler()\\n\",\n",
    "    \"D0 = scaler.fit_transform(X_pca)\\n\",\n",
    "    \"pca = PCA(n_components=n_features)\\n\",\n",
    "    \"pca.fit(D0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"A = pca.components_.T\\n\",\n",
    "    \"Z = D0 @ A\\n\",\n",
    "    \"\\n\",\n",
    "    \"i, j = 0, 3\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure()\\n\",\n",
    "    \"plt.scatter(Z[:, i], Z[:, j], c='w')\\n\",\n",
    "    \"plt.xlabel(f'PC {i+1}')\\n\",\n",
    "    \"plt.ylabel(f'PC {j+1}')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"eigenvector_i = 1 # Take the first one\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure()\\n\",\n",
    "    \"plt.bar(np.arange(n_features), A[:, eigenvector_i])\\n\",\n",
    "    \"plt.xticks(np.arange(n_features), traffic_features, rotation=90)\\n\",\n",
    "    \"plt.ylabel(f'{eigenvector_i+1} eigenvector weight')\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_pca = pd.DataFrame(X_pca, columns=traffic_features)\\n\",\n",
    "    \"print(df_pca.describe())\\n\",\n",
    "    \"corr_mat = sns.heatmap(df_pca.corr())\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"ex_var = pca.explained_variance_ratio_\\n\",\n",
    "    \"cum_ex_var = np.cumsum(ex_var)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure()\\n\",\n",
    "    \"plt.plot(ex_var, marker='o', markerfacecolor='none', color='r', linewidth=1, label='expl. var.')\\n\",\n",
    "    \"plt.plot(cum_ex_var, marker='o', markerfacecolor='none', color='k', linewidth=1, label='cum. expl. var.')\\n\",\n",
    "    \"plt.legend()\\n\",\n",
    "    \"plt.show()\\n\"\n",
    "   ],\n",
